# Root Compose environment. Copy to .env; never commit .env.
# AI provider credentials stay in the existing backend environment workflow.
POSTGRES_DB=csas
POSTGRES_USER=csas
# Replace locally before starting. No real password belongs in this template.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Host-run Python: localhost. In Compose: chroma:8000 (container port).
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Optional host ports for the all-Docker development stack.
AI_PORT=8090
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Local-only internal defaults are supplied by Compose. Override together if needed.
RAG_ACTIVE_INDEX=gms-live-dev-v1
RAG_DEV_PROVIDER=gms
RAG_TIMEOUT_SECONDS=60
