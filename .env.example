# Root Compose environment. Copy to .env; never commit .env.
# AI provider credentials stay in the existing backend environment workflow.
POSTGRES_DB=csas
POSTGRES_USER=csas
# Replace locally before starting. No real password belongs in this template.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Host-run Python: localhost. In Compose: chroma:8000 (container port).
CHROMA_HOST=localhost
CHROMA_PORT=8000
