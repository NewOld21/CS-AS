{
  "name": "csas-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.38.0",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.1"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
